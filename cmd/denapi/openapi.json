{
  "openapi": "3.0.3",
  "info": {
    "title": "den API",
    "version": "0.1.0",
    "description": "Loopback HTTP published by denapi. denapi dials the denctl Unix socket. This document does not include secrets."
  },
  "paths": {
    "/api/state": {
      "get": {
        "operationId": "getState",
        "summary": "Current nest, services, branches, and slots",
        "responses": {
          "200": {
            "description": "State JSON",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "operationId": "streamState",
        "summary": "Server-sent events. event name is state. A comment line is a keepalive.",
        "responses": {
          "200": {
            "description": "text/event-stream",
            "content": { "text/event-stream": { "schema": { "type": "string" } } }
          }
        }
      }
    }
  }
}
